{
  "name": "n8n-nodes-socioi",
  "version": "0.1.7",
  "description": "n8n community node for Socioi — schedule and publish social posts via the Socioi Public API",
  "keywords": [
    "n8n-community-node-package",
    "socioi",
    "social media",
    "scheduling",
    "n8n"
  ],
  "license": "MIT",
  "homepage": "https://socioi.com/docs/n8n",
  "author": {
    "name": "TechnSEO",
    "email": "hello@socioi.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/badarhse/n8n-nodes-socioi.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "npx rimraf dist && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build && npm run lint -c .eslintrc.prepublish.js nodes credentials package.json",
    "release": "npm version patch && git push origin main --follow-tags"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/SocioiApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Socioi/Socioi.node.js"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/parser": "~8.32.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.0",
    "n8n-workflow": "^2.16.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
